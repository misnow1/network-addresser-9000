# Copy to .env (gitignored) and fill in before running `docker compose up`.
# This is the deployment template — unlike .env.example (local `runserver`
# dev), DJANGO_DEBUG here must stay false. docker-compose.yml also forces
# DJANGO_DEBUG=false and DB_HOST=db explicitly, so this file alone can't put
# the deployment into debug mode even if edited incorrectly — see ADR 0009.

# Required outside DJANGO_DEBUG=true — see config/settings.py. No default;
# docker-compose.yml fails to start if this is left empty.
SECRET_KEY=

DJANGO_DEBUG=false

# Required when DJANGO_DEBUG=false — Django rejects every request with an
# empty ALLOWED_HOSTS. Include every hostname/IP the app will be reached by
# on the VPN, e.g.: localhost,127.0.0.1,na9000.internal.example.com
DJANGO_ALLOWED_HOSTS=

# Optional: host interface the app's port is published on (default
# 127.0.0.1, i.e. not reachable from other hosts at all). Publishing on
# 0.0.0.0 does NOT make this a VPN-only deployment by itself — that boundary
# is enforced by your host firewall / VPN policy, not by Compose.
HOST_BIND=127.0.0.1

DB_NAME=network_addresser_9000
DB_USER=na9000
# Required — no default; docker-compose.yml fails to start if left empty.
DB_PASSWORD=
DB_PORT=3306
# DB_HOST is fixed to the `db` Compose service name in docker-compose.yml;
# no need to set it here.

# Required — used only to initialize the MariaDB root account the first
# time the data volume is created. Changing it later does NOT change the
# password of an already-initialized volume (see README's Docker section).
MARIADB_ROOT_PASSWORD=
